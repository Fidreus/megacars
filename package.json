{
  "name": "megacars",
  "private": true,
  "version": "0.9.3",
  "description": "Retro top-down combat racer for the browser, inspired by the Amiga classics.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,server -c cyan,magenta \"vite\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "SERVER_PORT=8787 MEGACARS_DEV=1 node --watch src/server/main.ts",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.shared.json && tsc -p tsconfig.client.json && tsc -p tsconfig.server.json",
    "sim": "node scripts/simRace.ts",
    "soak": "node scripts/netSoak.ts",
    "track": "node scripts/checkTrack.ts",
    "stats": "node scripts/usageStats.ts"
  },
  "dependencies": {
    "geoip-country": "^5.0.202610210158",
    "lil-gui": "^0.21.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
